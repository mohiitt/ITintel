# Copy to .env for local development. Never commit real credentials.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=itintel
POSTGRES_USER=itintel
POSTGRES_PASSWORD=itintel_dev_change_me

# Source track: public_historical | historical_replay | synthetic_quality | synthetic_campus
ITINTEL_SOURCE_TRACK=public_historical

# Local source root (Phase 3+). S3 adapter uses bucket/prefix instead.
ITINTEL_LOCAL_SOURCE_DIR=./data/raw

# Optional S3 (AWS deployment — Phase 12)
# ITINTEL_S3_BUCKET=
# ITINTEL_S3_PREFIX=itintel/
# AWS_DEFAULT_REGION=us-west-2

# Analysis convention only — does not assert the source timezone
ITINTEL_ANALYSIS_TZ_LABEL=unknown_naive_wall_clock

ITINTEL_FORECAST_HORIZON_DAYS=7
ITINTEL_LOG_LEVEL=INFO
